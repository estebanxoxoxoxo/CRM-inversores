# Copy to .env and fill in with the Firebase project's web config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Token required by POST /api/investors (the research prompt embeds it). Public in the client bundle: it gates, it is not a secret.
VITE_INGEST_TOKEN=
# Public URL of the deployment for the prompt's endpoint. Optional: on Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL.
VITE_APP_URL=
